# rpi_agents secrets template
#
# On the Pi:
#   mkdir -p ~/.config/snn-agent
#   cp rpi_agents/.env.example ~/.config/snn-agent/.env
#   chmod 600 ~/.config/snn-agent/.env
#   nano ~/.config/snn-agent/.env   # fill in values

GEMINI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_TO=

# Optional (F03/ADR-0014): shared Basic Auth credential for the cloud
# dashboard -- same value the owner uses to log into the dashboard
# (ADR-0009). Leave blank to disable cloud sync (push is skipped, logged
# once). Also set SNN_AGENT_CLOUD_SYNC_URL (not a secret, not in this
# file) to the deployed Container App's ingest endpoint.
CLOUD_SYNC_USER=
CLOUD_SYNC_PASSWORD=
