{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatchAck",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "received_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "processed_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "durable_seq": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "running",
        "gap",
        "warmup"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "source_start_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_end_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "enum": [
              "missing_batch",
              "dropped_events",
              "restart",
              "adc_clipped"
            ]
          }
        },
        "required": [
          "schema_version",
          "device_id",
          "session_id",
          "epoch",
          "source_start_us",
          "source_end_us",
          "reason"
        ],
        "additionalProperties": false
      },
      "maxItems": 8,
      "minItems": 0
    },
    "decision": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source_time_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "encoder_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "trigger": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "valid",
            "warmup",
            "gap",
            "invalid"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "score_kind": {
          "enum": [
            "spike_count",
            "uncalibrated",
            "unavailable"
          ]
        },
        "provenance": {
          "enum": [
            "demo",
            "simulated",
            "measured"
          ]
        }
      },
      "required": [
        "schema_version",
        "device_id",
        "session_id",
        "epoch",
        "source_time_us",
        "model_hash",
        "decision_id",
        "event_id",
        "batch_seq",
        "encoder_hash",
        "trigger",
        "status",
        "score",
        "score_kind",
        "provenance"
      ],
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": "1.0"
              },
              "device_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "session_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "epoch": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "command_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "issued_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "mode": {
                "enum": [
                  "demo",
                  "live"
                ]
              },
              "type": {
                "const": "capture"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "max_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1048576
                  }
                },
                "required": [
                  "frames",
                  "max_bytes"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schema_version",
              "device_id",
              "session_id",
              "epoch",
              "command_id",
              "event_id",
              "issued_at",
              "expires_at",
              "mode",
              "type",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": "1.0"
              },
              "device_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "session_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "epoch": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "command_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "issued_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "mode": {
                "enum": [
                  "demo",
                  "live"
                ]
              },
              "type": {
                "const": "alarm"
              },
              "policy_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30000
                  },
                  "led": {
                    "type": "boolean"
                  },
                  "buzzer": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "duration_ms",
                  "led",
                  "buzzer"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schema_version",
              "device_id",
              "session_id",
              "epoch",
              "command_id",
              "event_id",
              "issued_at",
              "expires_at",
              "mode",
              "type",
              "policy_version",
              "parameters"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 32,
      "minItems": 0
    },
    "demo": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "epoch",
    "request_id",
    "received_seq",
    "processed_seq",
    "durable_seq",
    "status",
    "gaps",
    "decision",
    "commands",
    "demo"
  ],
  "additionalProperties": false
}
