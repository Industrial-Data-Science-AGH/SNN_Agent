digraph f03_flow {
  rankdir=TB;
  size="6.5,9!";
  ratio=compress;
  bgcolor="transparent";
  splines=polyline;
  node [shape=box, style="rounded,filled", fillcolor="#F4F6F8",
        color="#3A4756", fontname="Helvetica", fontsize=11, penwidth=1.2];
  edge [color="#5B6B7B", fontname="Helvetica", fontsize=9, penwidth=1.1,
        arrowsize=0.8];

  decide  [label="machine.run_cycle()\ndecision + email_sent + event_id known", shape=ellipse, style=dashed];
  build   [label="cloud_sync.build_payload()\n(record + jpeg snapshot)"];
  post    [label="cloud_sync.push()\nPOST, timeout=(3,5)s", fillcolor="#FDF1D6"];
  ok      [label="log success (debug)", shape=ellipse, style=dashed];
  enqueue [label="sync_queue.enqueue()\ncap 20, drop oldest if full", fillcolor="#FDF1D6"];
  flush   [label="cloud_sync.flush_queue()\nup to 5 oldest, stop at 1st failure", fillcolor="#FDF1D6"];
  removed [label="push ok -> sync_queue.remove()", shape=ellipse, style=dashed];
  kept    [label="push failed -> record_failure()\ndrop entry after 5 attempts", shape=ellipse, style=dashed];
  resleep [label="power.resleep()\n(unaffected either way)", shape=ellipse, style=dashed];

  decide  -> build   [label="1"];
  build   -> post    [label="2"];
  post    -> ok      [label="3a: 2xx within timeout"];
  post    -> enqueue [label="3b: timeout / error / non-2xx"];
  ok      -> flush   [label="4"];
  enqueue -> flush   [label="4"];
  flush   -> removed [label="5a: queued entry pushed"];
  flush   -> kept    [label="5b: queued entry still failing"];
  removed -> resleep [label="6"];
  kept    -> resleep [label="6"];
}
