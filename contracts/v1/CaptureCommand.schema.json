{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureCommand",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "mode": {
      "enum": [
        "demo",
        "live"
      ]
    },
    "type": {
      "const": "capture"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "frames",
        "max_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "epoch",
    "command_id",
    "event_id",
    "issued_at",
    "expires_at",
    "mode",
    "type",
    "parameters"
  ],
  "additionalProperties": false
}
