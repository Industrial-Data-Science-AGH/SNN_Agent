{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionState",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "mode": {
      "enum": [
        "demo",
        "live",
        "replay"
      ]
    },
    "model_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "encoder_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "running",
        "stopped"
      ]
    },
    "source_time_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "received_seq": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "processed_seq": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "durable_seq": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "batch_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "image_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "batch_bytes",
        "image_bytes",
        "max_frames"
      ],
      "additionalProperties": false
    },
    "demo": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "epoch",
    "boot_id",
    "mode",
    "model_hash",
    "encoder_hash",
    "state",
    "source_time_us",
    "received_seq",
    "processed_seq",
    "durable_seq",
    "limits",
    "demo"
  ],
  "additionalProperties": false
}
