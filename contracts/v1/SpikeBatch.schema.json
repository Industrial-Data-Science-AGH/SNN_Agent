{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpikeBatch",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "batch_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "encoder_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_start_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_end_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "spikes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dt_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "channel": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          }
        },
        "required": [
          "dt_us",
          "channel"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096,
      "minItems": 0
    },
    "quality": {
      "type": "object",
      "properties": {
        "dropped_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "adc_clipped": {
          "type": "boolean"
        }
      },
      "required": [
        "dropped_events",
        "adc_clipped"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "device_id",
    "session_id",
    "epoch",
    "boot_id",
    "batch_seq",
    "encoder_hash",
    "source_start_us",
    "source_end_us",
    "spikes",
    "quality"
  ],
  "additionalProperties": false
}
