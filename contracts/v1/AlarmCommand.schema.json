{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlarmCommand",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "mode": {
      "enum": [
        "demo",
        "live"
      ]
    },
    "type": {
      "const": "alarm"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "led": {
          "type": "boolean"
        },
        "buzzer": {
          "type": "boolean"
        }
      },
      "required": [
        "duration_ms",
        "led",
        "buzzer"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "epoch",
    "command_id",
    "event_id",
    "issued_at",
    "expires_at",
    "mode",
    "type",
    "policy_version",
    "parameters"
  ],
  "additionalProperties": false
}
