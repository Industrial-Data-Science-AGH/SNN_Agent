{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "demo": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "error",
    "demo"
  ],
  "additionalProperties": false
}
