{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "status": {
      "enum": [
        "photo_requested",
        "analyzing",
        "alarm_confirmed",
        "no_alarm",
        "review_required",
        "failed"
      ]
    },
    "decision": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source_time_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "encoder_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "trigger": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "valid",
            "warmup",
            "gap",
            "invalid"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "score_kind": {
          "enum": [
            "spike_count",
            "uncalibrated",
            "unavailable"
          ]
        },
        "provenance": {
          "enum": [
            "demo",
            "simulated",
            "measured"
          ]
        }
      },
      "required": [
        "schema_version",
        "device_id",
        "session_id",
        "epoch",
        "source_time_us",
        "model_hash",
        "decision_id",
        "event_id",
        "batch_seq",
        "encoder_hash",
        "trigger",
        "status",
        "score",
        "score_kind",
        "provenance"
      ],
      "additionalProperties": false
    },
    "vision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "device_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "session_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "event_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "image_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "ok",
                "unavailable",
                "error"
              ]
            },
            "glass_visible": {
              "enum": [
                true,
                false,
                "unknown"
              ]
            },
            "person_visible": {
              "enum": [
                true,
                false,
                "unknown"
              ]
            },
            "authorization": {
              "const": "unknown"
            },
            "image_quality": {
              "enum": [
                "good",
                "poor",
                "unknown"
              ]
            },
            "observation": {
              "type": "string",
              "maxLength": 512
            },
            "model_deployment": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "prompt_version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "error_code": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provenance": {
              "enum": [
                "demo",
                "real",
                "synthetic",
                "screen_capture_test"
              ]
            }
          },
          "required": [
            "schema_version",
            "device_id",
            "session_id",
            "epoch",
            "event_id",
            "image_id",
            "status",
            "glass_visible",
            "person_visible",
            "authorization",
            "image_quality",
            "observation",
            "model_deployment",
            "prompt_version",
            "error_code",
            "provenance"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": "1.0"
              },
              "device_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "session_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "epoch": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "command_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "issued_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "mode": {
                "enum": [
                  "demo",
                  "live"
                ]
              },
              "type": {
                "const": "capture"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "max_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1048576
                  }
                },
                "required": [
                  "frames",
                  "max_bytes"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schema_version",
              "device_id",
              "session_id",
              "epoch",
              "command_id",
              "event_id",
              "issued_at",
              "expires_at",
              "mode",
              "type",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": "1.0"
              },
              "device_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "session_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "epoch": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "command_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "issued_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "mode": {
                "enum": [
                  "demo",
                  "live"
                ]
              },
              "type": {
                "const": "alarm"
              },
              "policy_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30000
                  },
                  "led": {
                    "type": "boolean"
                  },
                  "buzzer": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "duration_ms",
                  "led",
                  "buzzer"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schema_version",
              "device_id",
              "session_id",
              "epoch",
              "command_id",
              "event_id",
              "issued_at",
              "expires_at",
              "mode",
              "type",
              "policy_version",
              "parameters"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 32,
      "minItems": 0
    },
    "demo": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "epoch",
    "event_id",
    "status",
    "decision",
    "vision",
    "commands",
    "demo"
  ],
  "additionalProperties": false
}
