flowchart TB
  A[Arduino encoder: 7 kanalow TTL, impulsy 15 ms]

  PF[1 Peak_fast]
  PS[2 Peak_strict]
  CR[3 crest_factor]
  PC[4 peak_counting]
  CV[5 CV]
  ZH[6 ZCR/HF proxy]
  CT[7 Continuity]

  IM[8 Impact combiner]
  FR[9 Fragmentation combiner]
  DE[10 Decision neuron]
  OUT[Arduino/RPi input]

  A --> PF
  A --> PS
  A --> CR
  A --> PC
  A --> CV
  A --> ZH
  A --> CT

  PF -->|J4 -> J1 +| IM
  PS -->|J4 -> J2 +| IM
  CR -->|J4 -> J3 +| IM

  PC -->|J4 -> J1 +| FR
  CV -->|J4 -> J2 +| FR
  ZH -->|J4 -> J3 +| FR

  IM -->|J4 -> J1 +| DE
  FR -->|J4 -> J2 +| DE
  CT -->|J4 -> J3 -| DE

  DE -->|J4| OUT

