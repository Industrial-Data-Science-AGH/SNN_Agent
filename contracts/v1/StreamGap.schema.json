{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamGap",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_start_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_end_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "enum": [
        "missing_batch",
        "dropped_events",
        "restart",
        "adc_clipped"
      ]
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "epoch",
    "source_start_us",
    "source_end_us",
    "reason"
  ],
  "additionalProperties": false
}
