{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviceStatus",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "input_kind": {
      "enum": [
        "uno",
        "stand_in",
        "replay"
      ]
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "reconnecting",
        "stalled",
        "error",
        "stopping"
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "boot_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "epoch": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "serial": {
      "type": "object",
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gaps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reconnects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last_frame_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "connected",
        "frames",
        "gaps",
        "rejected",
        "stalls",
        "reconnects",
        "last_frame_age_ms"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        }
      },
      "required": [
        "configured"
      ],
      "additionalProperties": false
    },
    "outbox": {
      "type": "object",
      "properties": {
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dead": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dropped_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "pending",
        "dead",
        "dropped_total"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "device_id",
    "reported_at",
    "agent_version",
    "input_kind",
    "state",
    "detail",
    "boot_id",
    "session_id",
    "epoch",
    "uptime_s",
    "serial",
    "camera",
    "outbox"
  ],
  "additionalProperties": false
}
